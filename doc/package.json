{
    "name": "extended-swc-viewer",
    "version": "0.25.3",
    "private": false,
    "homepage": "./",
    "sideEffects": [
        "*.css"
    ],
    "scripts": {
        "build": "rspack --mode=production",
        "predeploy": "npm run build",
        "deploy": "gh-pages -d ./build",
        "start": "rspack --version && rspack serve --mode=development",
        "routes": "build-react-routes ./src/app/",
        "demo": "tsx ./scripts/demo/index.ts ./src/app",
        "generate": "npm run routes && npm run demo",
        "format": "biome format --write src/",
        "lint": "biome check src/"
    },
    "dependencies": {
        "@mdx-js/react": "^3.1.1",
        "@openbraininstitute/morphoviewer": "file:../lib",
        "@tolokoban/react-state": "^0.7.3",
        "@tolokoban/tgd": "^2.0.132",
        "@tolokoban/type-guards": "^0.9.0",
        "@tolokoban/ui": "^0.25.4",
        "colord": "^2.9.3",
        "highlight.js": "^11.11.1",
        "jotai": "^2.20.0",
        "prismjs": "^1.30.0",
        "react": "19.2.5",
        "react-dom": "19.2.5",
        "react-simple-code-editor": "^0.14.1",
        "tslib": "^2.8.1"
    },
    "devDependencies": {
        "@mdx-js/loader": "^3.1.1",
        "@rspack/cli": "^1.7.11",
        "@rspack/core": "^1.7.11",
        "@types/mdx": "^2.0.13",
        "@types/node": "^25.6.0",
        "@types/prismjs": "^1.26.6",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "babel-loader": "^10.1.1",
        "build-react-routes": "^0.10.8",
        "clean-webpack-plugin": "^4.0.0",
        "css-loader": "^6.11.0",
        "gh-pages": "^6.3.0",
        "globals": "^17.6.0",
        "install": "^0.13.0",
        "lowlight": "^3.3.0",
        "mini-css-extract-plugin": "^2.10.2",
        "npm": "^11.13.0",
        "rehype-highlight": "^7.0.2",
        "rehype-highlight-code-lines": "^1.2.3",
        "remark-emoji": "^5.0.2",
        "remark-gfm": "^4.0.1",
        "remark-images": "^4.1.0",
        "ts-loader": "^9.5.7",
        "tsx": "^4.21.0",
        "typescript": "5.9.3",
        "webpack-shell-plugin-next": "^2.3.3",
        "workbox-webpack-plugin": "^7.4.1"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 3 chrome version",
            "last 3 firefox version",
            "last 3 safari version"
        ]
    },
    "port": 42341
}