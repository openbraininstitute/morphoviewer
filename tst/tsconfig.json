{
    "compilerOptions": {
        "target": "ES2021",
        "module": "preserve",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "outDir": "./dist"
    },
    "include": ["src/frontend/**/*.ts", "src/frontend/**/*.tsx"],
    "exclude": ["node_modules"]
}
